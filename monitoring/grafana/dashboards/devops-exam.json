{
  "title": "DevOps Exam",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Targets up",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(up)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Node CPU",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "App requests/s",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "sum(rate(app_http_requests_total[1m]))",
        "legendFormat": "rps",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Node memory available",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "expr": "node_memory_MemAvailable_bytes",
        "legendFormat": "{{instance}}",
        "refId": "A"
      }]
    }
  ]
}