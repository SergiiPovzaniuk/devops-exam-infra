pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  parameters {
    booleanParam(name: 'CONFIRM_DESTROY', defaultValue: false, description: 'Set TRUE to destroy exam AWS resources (EC2, NLB, VPC)')
    booleanParam(name: 'DESTROY_BOOTSTRAP', defaultValue: false, description: 'Also destroy S3 state bucket + DynamoDB lock')
  }

  environment {
    AWS_DEFAULT_REGION = 'eu-central-1'
    TF_IN_AUTOMATION   = '1'
  }

  stages {
    stage('Confirm') {
      steps {
        script {
          if (!params.CONFIRM_DESTROY) {
            error('CONFIRM_DESTROY=false — refusing to destroy. Rebuild with CONFIRM_DESTROY=true.')
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Prepare') {
      steps {
        sh '''
          set -e
          mkdir -p .ci
          if [ ! -f .ci/devops-exam.pub ]; then
            ssh-keygen -t ed25519 -f .ci/devops-exam -N "" -q
          fi
          cat > terraform/envs/exam/terraform.tfvars <<EOF
aws_region      = "eu-central-1"
az              = "eu-central-1a"
instance_type   = "t3.small"
key_name        = "devops-exam"
public_key_path = "/workspace/.ci/devops-exam.pub"
ssh_cidr        = "0.0.0.0/0"
monitoring_cidr = "0.0.0.0/0"
EOF
          cat > terraform/bootstrap/terraform.tfvars <<EOF
aws_region        = "eu-central-1"
state_bucket_name = "devops-exam-tfstate-646819876267"
lock_table_name   = "devops-exam-tf-lock"
EOF
        '''
      }
    }

    stage('Destroy exam') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-exam', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            set -e
            docker run --rm \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_DEFAULT_REGION \
              -e TF_IN_AUTOMATION \
              -v "$PWD":/workspace \
              -w /workspace/terraform/envs/exam \
              hashicorp/terraform:1.9 \
              init -input=false
            docker run --rm \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_DEFAULT_REGION \
              -e TF_IN_AUTOMATION \
              -v "$PWD":/workspace \
              -w /workspace/terraform/envs/exam \
              hashicorp/terraform:1.9 \
              destroy -auto-approve -input=false
          '''
        }
      }
    }

    stage('Destroy bootstrap') {
      when {
        expression { return params.DESTROY_BOOTSTRAP }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: 'aws-exam', usernameVariable: 'AWS_ACCESS_KEY_ID', passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          sh '''
            set -e
            docker run --rm \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_DEFAULT_REGION \
              -e TF_IN_AUTOMATION \
              -v "$PWD":/workspace \
              -w /workspace/terraform/bootstrap \
              hashicorp/terraform:1.9 \
              init -input=false
            docker run --rm \
              -e AWS_ACCESS_KEY_ID \
              -e AWS_SECRET_ACCESS_KEY \
              -e AWS_DEFAULT_REGION \
              -e TF_IN_AUTOMATION \
              -v "$PWD":/workspace \
              -w /workspace/terraform/bootstrap \
              hashicorp/terraform:1.9 \
              destroy -auto-approve -input=false
          '''
        }
      }
    }
  }

  post {
    success {
      echo 'Terraform destroy finished.'
    }
    failure {
      echo 'Destroy failed — check AWS console for leftover resources.'
    }
  }
}
